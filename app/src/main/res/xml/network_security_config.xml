<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- VPN Gate's public list API is only served over HTTP. Entries fetched from
         it are marked unverified; the signed list from backend/ is HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">www.vpngate.net</domain>
    </domain-config>
</network-security-config>
