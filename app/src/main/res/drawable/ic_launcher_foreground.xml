<?xml version="1.0" encoding="utf-8"?>
<!-- Volta logo: gold lightning bolt over a teal globe (speed + going anywhere),
     with a small green "FREE" pill. Adaptive icon, 108dp grid, safe zone 21..87. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Globe: outline, equator, meridian -->
    <path android:strokeWidth="2.6" android:strokeAlpha="0.95" android:fillColor="#00000000"
        android:pathData="M54,47 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="33" android:startY="26"
                android:endX="75" android:endY="68"
                android:startColor="#5BF0C9" android:endColor="#2E8BFF" />
        </aapt:attr>
    </path>
    <path android:strokeColor="#5BF0C9" android:strokeWidth="1.5" android:strokeAlpha="0.55"
        android:fillColor="#00000000"
        android:pathData="M33.5,47 H74.5 M54,47 m-9,0 a9,21 0 1,0 18,0 a9,21 0 1,0 -18,0" />

    <!-- Bolt, outlined in the background colour so it cuts cleanly through the globe -->
    <path android:strokeColor="#101632" android:strokeWidth="3.4" android:strokeLineJoin="round"
        android:pathData="M58.5,21.5 L41.5,50 H52.5 L48.5,73 L67.5,42.5 H56.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="50" android:startY="22"
                android:endX="58" android:endY="73"
                android:startColor="#FFE27A" android:endColor="#FF9F1C" />
        </aapt:attr>
    </path>

    <!-- FREE pill -->
    <path android:fillColor="#00E5A8"
        android:pathData="M46.5,74 H61.5 A5,5 0 0 1 61.5,84 H46.5 A5,5 0 0 1 46.5,74 Z" />
    <path android:strokeColor="#0B1020" android:strokeWidth="1.2"
        android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000"
        android:pathData="M44.6,76.6 V81.4 M44.6,76.6 H47.6 M44.6,78.9 H47
            M49.4,81.4 V76.6 H51.4 A1.15,1.15 0 0 1 51.4,78.9 H49.4 M51,78.9 L52.6,81.4
            M57.4,76.6 H54.4 V81.4 H57.4 M54.4,79 H56.8
            M62.6,76.6 H59.6 V81.4 H62.6 M59.6,79 H62" />
</vector>
