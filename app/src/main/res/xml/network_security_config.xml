<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No plain HTTP anywhere, and only the system's CAs: certificates the user (or an
         MDM / "install this certificate" prompt) adds are never trusted by Volta. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
